# ---------------------------------------------------------------
# متغیرهای محیطی — این فایل را به .env.local کپی کنید و مقادیر را بگذارید
# هیچ کلیدی را داخل کد قرار ندهید؛ فقط از process.env خوانده می‌شود.
# ---------------------------------------------------------------

# کلید OpenRouter برای مدل‌های رایگان (اولویت اول)
# دریافت از: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# کلید DeepSeek به‌عنوان Fallback پولی (اولویت آخر)
# دریافت از: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# آدرس رسمی DeepSeek و نام مدل (مقادیر پیش‌فرض)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------
# اختیاری: ذخیره‌سازی سوابق به‌صورت دائمی (Vercel KV / Upstash Redis)
# اگر این دو مقدار تنظیم نشوند، سوابق در localStorage مرورگر ذخیره می‌شوند.
# در Vercel کافی است از Marketplace یک دیتابیس Upstash Redis وصل کنید؛
# متغیرهای KV_REST_API_URL و KV_REST_API_TOKEN خودکار اضافه می‌شوند.
# ---------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# نام‌های جایگزین Upstash (هر کدام تنظیم شود کافی است)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# احراز هویت و مدیر اولیه
# AUTH_SECRET را حتماً در Production به یک رشته‌ی تصادفی طولانی تغییر دهید.
# در اولین اجرا، اگر هیچ کاربری وجود نداشته باشد حساب مدیر ساخته می‌شود.
# ---------------------------------------------------------------
AUTH_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=مدیر سامانه

# ---------------------------------------------------------------
# اختیاری: Vercel Blob برای آپلود فایل‌های بالای ۴ مگابایت تا ۱۰ مگابایت
# در Vercel کافی است از Storage یک Blob Store (Private) بسازید و به پروژه
# متصل کنید؛ BLOB_READ_WRITE_TOKEN خودکار به محیط پروژه اضافه می‌شود. برای
# اجرای محلی همان توکن را از تنظیمات Blob Store اینجا بگذارید.
# ---------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------
# اختیاری: تنظیم دقیق زنجیره مدل‌ها و بودجه زمانی
# ---------------------------------------------------------------
# لیست مدل‌های رایگان با کاما جدا شود؛ اگر خالی باشد به‌صورت خودکار
# از OpenRouter مدل‌های رایگان کشف می‌شوند.
OPENROUTER_FREE_MODELS=
# حداکثر تعداد کاراکتر ارسالی به مدل (پیش‌فرض ۲۴۰۰۰)
AI_MAX_INPUT_CHARS=
# مهلت کل درخواست تحلیل به میلی‌ثانیه (پیش‌فرض ۵۵۰۰۰)
AI_TOTAL_BUDGET_MS=
# مهلت هر مدل رایگان (پیش‌فرض ۲۰۰۰۰)
FREE_MODEL_TIMEOUT_MS=
# زمانی که برای Fallback دیپ‌سیک کنار گذاشته می‌شود (پیش‌فرض ۲۰۰۰۰)
AI_DEEPSEEK_RESERVE_MS=
